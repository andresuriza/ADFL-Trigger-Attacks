# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Se regeneran en tiempo de ejecución (no hacer commit)
data/            # caché de datasets de torchvision
runs/            # directorios de trabajo, logs y notebooks ejecutados de cada ejecución
_empty/          # marcador de posición para el staging
*.log
*.tar.gz         # archivos de datasets que se pueden volver a descargar

# Pesos de los modelos (se publican aparte, ver README)
# ~1.6 GB en total, un archivo supera el límite de 100 MB de GitHub; usar `git add -f <archivo>` para forzarlo.
*.pt
